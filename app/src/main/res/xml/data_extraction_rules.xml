<?xml version="1.0" encoding="utf-8"?>
<!--
   Controls Android 12+ Auto Backup (cloud-backup, restored on reinstall/new device)
   and device-to-device transfer. Both sections opt in explicitly, so anything not
   listed here — Firebase Auth's cached credentials, caches, logs — is left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="studiare_database"/>
        <include domain="file" path="datastore/settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="studiare_database"/>
        <include domain="file" path="datastore/settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
